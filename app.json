{
  "expo": {
    "name": "TATAMI",
    "slug": "tatami-cdl",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "scheme": "tatami",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "fr.lecampdesloups.mobile"
    },
    "android": {
      "package": "fr.lecampdesloups.mobile"
    },
    "plugins": [
      "expo-status-bar",
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "Autoriser TATAMI à sélectionner vos photos et vidéos.",
          "microphonePermission": false
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Autoriser TATAMI à accéder aux médias.",
          "savePhotosPermission": "Autoriser TATAMI à enregistrer vos médias.",
          "granularPermissions": [
            "photo",
            "video"
          ]
        }
      ],
      "expo-video"
    ]
  }
}
